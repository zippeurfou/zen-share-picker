{
  "manifest_version": 2,
  "name": "Zen Share Picker",
  "version": "0.3.0",
  "description": "A centered, keyboard-first tab, window and screen picker for Zen's screen-share prompt, and a cleaner sharing bar.",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-share-picker@zippeurfou.github.io",
      "strict_min_version": "160.0",
      "update_url": "https://github.com/zippeurfou/zen-share-picker/releases/latest/download/updates.json"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "experiment_apis": {
    "sharePicker": {
      "schema": "src/experiment/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["sharePicker"]],
        "script": "src/experiment/api.js"
      }
    }
  }
}
